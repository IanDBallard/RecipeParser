          dict({
            'step': 3,
            'text': 'THEREUPON ADD {{ing_03|QUINCE-APPLE CIDER, BOILED DOWN ONE HALF}}, THAT IS WHICH HAS EVAPORATED IN THE HEAT OF THE SUN TO THE CONSISTENCY OF HONEY.',
