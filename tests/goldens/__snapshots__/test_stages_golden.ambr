            'text': 'GRIND {{ing_01|PEPPER WHICH HAS BEEN SOAKED OVERNIGHT}}.',
          }),
          dict({
            'step': 2,
            'text': 'ADD SOME MORE {{ing_02|STOCK}} AND WORK IT INTO A SMOOTH PASTE.',
