            'title': 'Step',
            'type': 'integer',
          }),
          'value': dict({
            'description': "What the writer meant: '180C,oven', '350F', 'gas4', '180C,oven,fan=160C'.",
            'title': 'Value',
            'type': 'string',
          }),
        }),
        'required': list([
          'step',
          'quote',
          'value',
        ]),
        'title': 'TemperatureMention',
