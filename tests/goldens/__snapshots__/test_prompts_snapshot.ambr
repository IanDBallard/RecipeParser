# name: TestSchemaSnapshots.test_direction_mentions_schema
  dict({
    '$defs': dict({
      'DirectionMention': dict({
        'description': 'One ingredient mention in a raw direction step, as the re-tagging pass reports it.',
        'properties': dict({
          'context': dict({
            'default': '',
            'description': 'The quote with about five words around it, copied exactly from the step: it tells apart two mentions with the same words.',
            'title': 'Context',
            'type': 'string',
          }),
          'ingredient_id': dict({
            'description': 'The id of the ingredient the words refer to.',
            'title': 'Ingredient Id',
            'type': 'string',
          }),
          'quote': dict({
            'description': 'The words to wrap, copied exactly from that step.',
            'title': 'Quote',
            'type': 'string',
          }),
          'step': dict({
            'description': '1-based number of the step the mention is in.',
            'title': 'Step',
            'type': 'integer',
          }),
          'use': dict({
            'description': "all, rest, none, or the amount as a decimal and a unit, e.g. '0.5 cup'.",
            'title': 'Use',
            'type': 'string',
          }),
        }),
        'required': list([
          'step',
          'quote',
          'ingredient_id',
          'use',
        ]),
        'title': 'DirectionMention',
        'type': 'object',
      }),
    }),
    'description': "The re-tagging pass's whole answer for one recipe.",
    'properties': dict({
      'mentions': dict({
        'items': dict({
          '$ref': '#/$defs/DirectionMention',
        }),
        'title': 'Mentions',
        'type': 'array',
      }),
    }),
    'title': 'DirectionMentions',
    'type': 'object',
  })
