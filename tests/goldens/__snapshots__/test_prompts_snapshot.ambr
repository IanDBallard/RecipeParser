# name: TestSchemaSnapshots.test_toc_list_schema
  dict({
    '$defs': dict({
      'TocEntry': dict({
        'description': 'Single TOC entry: recipe title and optional page/section reference.',
        'properties': dict({
          'page': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Page number (1-based) if known; null otherwise.',
            'title': 'Page',
          }),
          'title': dict({
            'description': 'The recipe or section title.',
            'title': 'Title',
            'type': 'string',
          }),
        }),
        'required': list([
          'title',
        ]),
        'title': 'TocEntry',
        'type': 'object',
      }),
    }),
    'description': 'Parsed table of contents from a cookbook.',
    'properties': dict({
      'entries': dict({
        'description': 'Ordered list of TOC entries (recipe titles and optional page numbers).',
        'items': dict({
          '$ref': '#/$defs/TocEntry',
        }),
        'title': 'Entries',
        'type': 'array',
      }),
    }),
    'required': list([
      'entries',
    ]),
    'title': 'TocList',
    'type': 'object',
  })
