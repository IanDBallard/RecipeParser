# name: TestSchemaSnapshots.test_recipe_list_schema
  dict({
    '$defs': dict({
      'RecipeExtraction': dict({
        'properties': dict({
          'byline': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "The recipe author's name when a byline is printed ('By Melissa Clark' gives 'Melissa Clark'). null when none is printed.",
            'title': 'Byline',
          }),
          'categories': dict({
            'description': 'Paprika taxonomy categories assigned by the categorisation pass.',
            'items': dict({
              'type': 'string',
            }),
            'title': 'Categories',
            'type': 'array',
          }),
          'cook_time': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "Cook time (e.g., '30 mins').",
            'title': 'Cook Time',
          }),
          'description': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "The headnote or introduction printed with the recipe, in the source's own words, at most one paragraph. null when there is none.",
            'title': 'Description',
          }),
          'directions': dict({
            'description': 'List of step-by-step cooking instructions.',
            'items': dict({
              'type': 'string',
            }),
            'title': 'Directions',
            'type': 'array',
          }),
          'ingredients': dict({
            'description': 'List of ingredients, each copied exactly as the source writes it. Convert unicode fractions to text fractions (e.g. ½ -> 1/2).',
            'items': dict({
              'type': 'string',
            }),
            'title': 'Ingredients',
            'type': 'array',
          }),
          'name': dict({
            'description': 'The name or title of the recipe.',
            'title': 'Name',
            'type': 'string',
          }),
          'notes': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Any additional notes or headnotes from the author.',
            'title': 'Notes',
          }),
          'nutritional_info': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "The recipe's nutrition statement, verbatim, as one line ('572 calories; 19 grams fat; 35 grams protein'). null when the text carries none.",
            'title': 'Nutritional Info',
          }),
          'photo_filename': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'The filename of the hero/finished-dish photo for this recipe. If a [HERO IMAGE: filename] marker is present, always use that filename. Otherwise look for an [IMAGE: filename] marker that appears just before the recipe title/ingredients, or just after the last ingredient and before the first method step. Ignore images embedded within numbered method steps — those are process shots. If no suitable hero image is present, leave blank.',
            'title': 'Photo Filename',
          }),
          'prep_time': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "Preparation time (e.g., '15 mins').",
            'title': 'Prep Time',
          }),
          'servings': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "Number of servings (e.g., '4 servings', '2-4').",
            'title': 'Servings',
          }),
          'stated_source': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'The publication, website or book this text names as its own source, exactly as the text names it: a masthead, a book title, a site name. Never the name of an AI model or a tool. null when the text does not say.',
            'title': 'Stated Source',
          }),
          'total_time': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "The total or overall time when the text states one ('Total Time 8 to 10 hours, plus refrigeration'). Never the sum of prep and cook. null when the text states no total.",
            'title': 'Total Time',
          }),
        }),
        'required': list([
          'name',
          'ingredients',
          'directions',
        ]),
        'title': 'RecipeExtraction',
        'type': 'object',
      }),
    }),
    'properties': dict({
      'recipes': dict({
        'description': 'A list of all distinct recipes found in the text chunk.',
        'items': dict({
          '$ref': '#/$defs/RecipeExtraction',
        }),
        'title': 'Recipes',
        'type': 'array',
      }),
    }),
    'required': list([
      'recipes',
    ]),
    'title': 'RecipeList',
    'type': 'object',
  })
