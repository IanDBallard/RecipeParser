          }),
          'count': dict({
            'anyOf': list([
              dict({
                'type': 'number',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'title': 'Count',
          }),
          'count_unit': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'title': 'Count Unit',
          }),
          'food': dict({
            'title': 'Food',
            'type': 'string',
          }),
          'key': dict({
            'title': 'Key',
            'type': 'string',
          }),
          'pantry': dict({
            'title': 'Pantry',
            'type': 'boolean',
          }),
        }),
        'required': list([
          'key',
          'food',
          'aisle',
          'pantry',
        ]),
        'title': 'ClassifiedItem',
        'type': 'object',
      }),
    }),
    'properties': dict({
      'items': dict({
        'items': dict({
          '$ref': '#/$defs/ClassifiedItem',
        }),
        'title': 'Items',
