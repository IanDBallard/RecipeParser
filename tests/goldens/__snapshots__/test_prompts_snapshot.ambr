# name: TestSchemaSnapshots.test_toc_classification_schema
  dict({
    'description': 'Result of classifying which TOC entries are recipe titles vs section headers.',
    'properties': dict({
      'recipe_indices': dict({
        'description': '0-based indices of TOC entries that are specific recipe/dish names, not section headers.',
        'items': dict({
          'type': 'integer',
        }),
        'title': 'Recipe Indices',
        'type': 'array',
      }),
    }),
    'required': list([
      'recipe_indices',
    ]),
    'title': 'TocRecipeClassification',
    'type': 'object',
  })
