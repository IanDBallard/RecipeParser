# name: TestSchemaSnapshots.test_classify_schema
  dict({
    '$defs': dict({
      'ClassifiedItem': dict({
        'properties': dict({
          'aisle': dict({
            'enum': list([
              'produce',
              'meat_fish',
              'dairy_eggs',
              'bakery',
              'dry_goods',
