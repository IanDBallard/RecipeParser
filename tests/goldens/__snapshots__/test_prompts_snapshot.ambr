            'description': 'Unit of measure, e.g., "cups".',
            'title': 'Unit',
          }),
        }),
        'required': list([
          'id',
          'name',
          'fallback_string',
        ]),
        'title': 'StructuredIngredient',
        'type': 'object',
      }),
      'TokenizedDirection': dict({
        'properties': dict({
          'step': dict({
            'description': '1-based step number.',
            'title': 'Step',
            'type': 'integer',
          }),
          'text': dict({
            'description': "Direction text with Fat Tokens {{id|words|use}}: words exactly as written, use one of all, rest, none, or an amount such as '0.5 cup'.",
            'title': 'Text',
            'type': 'string',
          }),
        }),
        'required': list([
          'step',
          'text',
        ]),
        'title': 'TokenizedDirection',
        'type': 'object',
      }),
    }),
    'description': 'Internal refinement pass output.',
    'properties': dict({
      'base_servings': dict({
        'anyOf': list([
          dict({
            'type': 'integer',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'title': 'Base Servings',
      }),
      'grid_categories': dict({
        'description': "Multipolar categorization result. Keys are axis names (e.g. 'Cuisine'), values are lists of 0-2 matching tags from that axis. Return [] for any axis that does not apply — never hallucinate tags.",
        'title': 'Grid Categories',
        'type': 'object',
      }),
      'source_uom_system_detected': dict({
        'anyOf': list([
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'default': None,
        'description': 'The measuring system the writer used: one of "US", "UK", "EU", "AU", "Imperial", judged only from evidence in the recipe or its source host. null when there is no evidence.',
        'title': 'Source Uom System Detected',
      }),
      'source_uom_system_evidence': dict({
