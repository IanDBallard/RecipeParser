    'properties': dict({
      'base_servings': dict({
        'anyOf': list([
          dict({
            'type': 'integer',
          }),
          dict({
            'type': 'null',
          }),
        ]),
        'title': 'Base Servings',
      }),
      'grid_categories': dict({
        '$ref': '#/$defs/GridCategories',
        'description': "Multipolar categorization. For each axis, pick 0-2 matching tags from the provided list. Return [] for axes that don't apply.",
      }),
      'structured_ingredients': dict({
        'items': dict({
          '$ref': '#/$defs/StructuredIngredient',
        }),
        'title': 'Structured Ingredients',
        'type': 'array',
      }),
      'title': dict({
        'title': 'Title',
        'type': 'string',
      }),
      'tokenized_directions': dict({
        'items': dict({
          '$ref': '#/$defs/TokenizedDirection',
        }),
        'title': 'Tokenized Directions',
        'type': 'array',
      }),
    }),
    'required': list([
      'title',
      'base_servings',
      'structured_ingredients',
      'tokenized_directions',
    ]),
    'title': 'CayenneRefinementWithGrid',
    'type': 'object',
  })
