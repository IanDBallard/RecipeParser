      "title": "Buttermilk Scones",
      "tokenized_directions": [
        {
          "step": 1,
          "text": "Heat the oven to 425F. Line a tray with parchment."
        },
        {
          "step": 2,
          "text": "Rub the {{ing_04|butter}} into the {{ing_01|flour}}, {{ing_02|baking powder}} and {{ing_03|salt}} until it looks like coarse crumbs."
        },
        {
          "step": 3,
          "text": "Stir in the {{ing_05|buttermilk}} until a shaggy dough forms. Do not overwork it."
        },
        {
          "step": 4,
          "text": "Pat out to 1 inch thick, cut rounds, and bake for 12 to 14 minutes."
