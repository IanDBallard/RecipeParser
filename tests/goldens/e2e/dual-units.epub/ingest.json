      "title": "Brown Butter Shortbread",
      "tokenized_directions": [
        {
          "step": 1,
          "text": "Brown the {{ing_01|butter}} in a pale pan until it smells of hazelnuts, then cool until thick."
        },
        {
          "step": 2,
          "text": "Beat in the {{ing_02|sugar}}, then the {{ing_03|flour}} and {{ing_04|salt}}, to a stiff paste."
        },
        {
          "step": 3,
          "text": "Press into a tin, dock all over, and bake at 325F for 40 minutes."
        },
        {
          "step": 4,
          "text": "Cut while warm and cool in the tin."
        }
      ]
