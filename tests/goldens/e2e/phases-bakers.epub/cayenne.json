        "title": "Overnight Country Loaf",
        "tokenized_directions": [
          {
            "step": 1,
            "text": "Mix the levain ingredients ({{ing_01|whole wheat flour}}, {{ing_02|water}}, {{ing_03|ripe starter}}) and leave at room temperature for 10 hours."
          },
          {
            "step": 2,
            "text": "Mix the {{ing_04|bread flour}}, {{ing_05|whole wheat flour}} and {{ing_06|water}} and rest for 40 minutes."
          },
          {
            "step": 3,
            "text": "Add the levain and {{ing_07|fine salt}}, then fold every 30 minutes for 3 hours."
          },
          {
            "step": 4,
            "text": "Shape, retard overnight, and bake at 475F in a covered pot for 20 minutes, then 20 uncovered."
          }
        ]
